{
	"name": "amno",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"overrides": {
		"typebox": "1.1.6"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && tar -czvf build.tar.gz build/",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"test:e2e": "playwright install && playwright test",
		"db:seed": "tsx scripts/seed-dev.ts",
		"admin:create": "tsx scripts/create-admin.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^0.577.0",
		"@playwright/test": "^1.63.0",
		"@prgm/sveltekit-progress-bar": "^3.0.2",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/table-core": "^8.21.3",
		"@types/node": "^25.9.9",
		"@types/papaparse": "^5.5.2",
		"@vitest/browser-playwright": "^5.0.3",
		"auth": "^1.7.7",
		"better-auth": "^1.7.7",
		"bits-ui": "^2.19.4",
		"clsx": "^2.1.1",
		"dotenv": "^18.0.5",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.3",
		"drizzle-seed": "^0.3.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"paneforge": "^1.0.2",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"sveltekit-flash-message": "^2.4.6",
		"sveltekit-superforms": "^2.31.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0",
		"zod": "^4.6.5"
	},
	"dependencies": {
		"@nahu/admin-kit": "file:../admin-kit",
		"browser-image-compression": "^2.0.2",
		"chart.js": "^4.5.1",
		"html-to-image": "^1.11.13",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.8",
		"mode-watcher": "^1.1.0",
		"mysql2": "^3.24.5",
		"nodemailer": "^10.0.13",
		"papaparse": "^5.7.0",
		"pluralize": "^8.0.0",
		"read-excel-file": "^9.3.10",
		"write-excel-file": "^4.1.1"
	}
}
