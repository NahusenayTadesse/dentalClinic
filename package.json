{
	"name": "spotless-system",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"overrides": {
		"typebox": "1.1.6"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && tar -czvf build.tar.gz build/",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"test:e2e": "playwright install && playwright test",
		"db:seed": "tsx scripts/seed-dev.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^9.39.4",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^0.562.0",
		"@playwright/test": "^1.60.0",
		"@prgm/sveltekit-progress-bar": "^3.0.2",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/table-core": "^8.21.3",
		"@types/node": "^25.9.1",
		"@vitest/browser-playwright": "^4.1.8",
		"auth": "^1.6.23",
		"better-auth": "^1.6.23",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"drizzle-seed": "^0.3.1",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"paneforge": "^1.0.2",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.1.1",
		"sveltekit-flash-message": "^2.4.6",
		"sveltekit-superforms": "^2.30.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.22.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^7.3.5",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"browser-image-compression": "^2.0.2",
		"chart.js": "^4.5.1",
		"ethiopian-calendar-new": "^1.1.0",
		"html-to-image": "^1.11.13",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.8",
		"mode-watcher": "^1.1.0",
		"mysql2": "^3.22.4",
		"nodemailer": "^7.0.13",
		"papaparse": "^5.5.3",
		"pluralize": "^8.0.0"
	}
}
