# Replace with your DB credentials!
DATABASE_URL="mysql://user:password@host:port/db-name"
LEAVE_CRON_SECRET=

ORIGIN=""

# The largest request the production server accepts. Required: without it adapter-node refuses
# anything over 512K, while the app takes files up to 10 MB (MAX_UPLOAD_BYTES) and radiographs are
# sent uncompressed — so uploads that work under `npm run dev` fail once deployed. 12M leaves room
# for the rest of the form around a 10 MB file.
BODY_SIZE_LIMIT=12M

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# The daily backup's cron secret (/api/cron/backup), and where to copy each backup — a USB drive
# or another machine's share. Leave BACKUP_COPY_DIR empty to keep backups only on this server.
BACKUP_CRON_SECRET=
BACKUP_COPY_DIR=

# The folder the X-ray sensor or panoramic software exports JPEG/PNG images into. Images there
# are filed to patients from Patients → Radiograph Inbox. Leave empty to attach by hand only.
RADIOGRAPH_INBOX=

# The check for online payments still waiting (/api/cron/online-payments) — every ten minutes or
# so. It finds payments whose gateway could not reach this server to say they were paid.
PAYMENTS_CRON_SECRET=
